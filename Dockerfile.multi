FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

COPY pom.xml .

RUN mvn dependency:go-offline

COPY src ./src

RUN mvn clean package -DskipTests # testando

FROM gcr.io/distroless/java21-debian12

WORKDIR /app

USER nonroot:nonroot

COPY --from=builder /build/target/demo-0.0.1-SNAPSHOT.jar ./api.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar"]
CMD ["api.jar"]